# Copie para .env e ajuste. Nunca versione o .env real.
RAG_CORPUS_DIR=corpus
RAG_ENVIRONMENT=dev
RAG_LOG_LEVEL=INFO

# Fatiamento
RAG_CHUNK_MAX_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=150

# Recuperacao e geracao
RAG_TOP_K=5
RAG_REQUIRE_CITATION=true

# Limiares de qualidade usados por `docs-rag eval --strict`
RAG_MIN_RECALL_AT_K=0.8
RAG_MIN_MRR=0.6
